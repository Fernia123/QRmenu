---
import Icon from './Icon.astro';
import Logo from './Logo.astro';

const currentPath = Astro.url.pathname;
const businessName = Astro.props.businessName || 'MiCarta';

const nav = [
  { label: 'Dashboard', href: '/dashboard', icon: 'dashboard', exact: true },
  { label: 'Platos', href: '/dashboard#platos', icon: 'dishes' },
  { label: 'Categorías', href: '/dashboard#categorias', icon: 'folder' },
  { label: 'Ver mi carta', href: '/menu', icon: 'eye' },
  { label: 'Configuración', href: '/dashboard#config', icon: 'gear' },
] as const;

const isActive = (href: string, exact?: boolean) =>
  exact ? currentPath === href : currentPath.split('#')[0] === href.split('#')[0];
---

<div class="flex flex-col h-full">
  <!-- Logo -->
  <div class="px-5 py-6 flex items-center justify-between">
    <a href="/" class="flex items-center gap-3" aria-label="Menu QR - inicio">
      <Logo size="sm" onDark />
    </a>

    {Astro.props.mobile && (
      <button
        id="closeMenuBtn"
        class="w-9 h-9 rounded-lg hover:bg-white/10 transition flex items-center justify-center text-ink-300 hover:text-white"
        aria-label="Cerrar menú"
      >
        <Icon name="close" class="w-5 h-5" />
      </button>
    )}
  </div>

  <!-- Nav -->
  <nav class="px-3 flex-1 overflow-y-auto" aria-label="Principal">
    {nav.map((item) => (
      <a
        href={item.href}
        aria-current={isActive(item.href, 'exact' in item && item.exact) ? 'page' : undefined}
        class={`flex items-center gap-3 px-3 py-2.5 rounded-xl mb-1 text-sm transition ${
          isActive(item.href, 'exact' in item && item.exact)
            ? 'bg-brand-500/15 text-brand-300 font-semibold'
            : 'text-ink-300 hover:bg-white/5 hover:text-white'
        }`}
      >
        <Icon name={item.icon} class="w-5 h-5" />
        <span>{item.label}</span>
      </a>
    ))}
  </nav>

  <!-- User -->
  <div class="p-4 border-t border-white/10">
    <div class="flex items-center gap-3 p-2.5 rounded-xl hover:bg-white/5 transition">
      <span class="w-9 h-9 bg-gradient-to-br from-brand-400 to-brand-600 text-white rounded-full flex items-center justify-center font-bold text-sm shrink-0">
        MR
      </span>
      <span class="flex-1 min-w-0">
        <span class="block font-semibold text-sm text-ink-100 truncate">{businessName}</span>
        <span class="block text-xs text-ink-400 truncate">Administrador</span>
      </span>
    </div>

    <a
      href="/login"
      data-logout
      class="flex items-center gap-2 px-2.5 py-2.5 mt-1 text-sm text-ink-400 hover:text-cherry-500 transition"
    >
      <Icon name="logout" class="w-5 h-5" />
      Cerrar sesión
    </a>
  </div>
</div>
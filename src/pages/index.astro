---
import Layout from '../layouts/Layout.astro';
import Logo from '../components/Logo.astro';
import Icon from '../components/Icon.astro';
import Button from '../components/Button.astro';
import { features, steps, plans } from '../data/content';
import { fetchPlatos, fetchRestaurant } from '../db/database';

/*Marca del agregago de Logo  */
import { Image } from 'astro:assets';
import logo from '../assets/logo_sinfondo.png';

let heroDishes: any[] = [];
let restaurant: any = { name: '', slogan: '', logo: '🍽️', visits: 0, visitsGrowth: 0 };

try {
  const [dishes, rest] = await Promise.all([fetchPlatos(), fetchRestaurant()]);
  heroDishes = dishes.filter((d) => d.disponible).slice(0, 3);
  restaurant = rest;
} catch (e) {
  console.error('Error cargando datos de la landing:', e);
}

const nav = [
  { label: 'Características', href: '#features' },
  { label: 'Cómo funciona', href: '#how' },
  { label: 'Precios', href: '#pricing' },
];
---

<Layout>
  <!-- Ambient background -->
  <div class="fixed inset-0 overflow-hidden pointer-events-none" aria-hidden="true">
    <div class="absolute -top-40 right-0 w-[600px] h-[600px] bg-brand-500/10 rounded-full blur-[150px]"></div>
    <div class="absolute bottom-0 -left-40 w-[500px] h-[500px] bg-navy-500/10 rounded-full blur-[140px]"></div>
  </div>

  <!-- ── Nav ─────────────────────────────────────────── -->
  <nav class="relative z-20 max-w-7xl mx-auto flex items-center justify-between px-6 lg:px-20 py-6">
    <a href="/" aria-label="MiCarta - inicio"><Logo size="sm" onDark /></a>

    <div class="hidden md:flex items-center gap-8">
      {nav.map((item) => (
        <a href={item.href} class="text-sm font-medium text-ink-300 hover:text-white transition">
          {item.label}
        </a>
      ))}
    </div>

    <div class="flex items-center gap-2 sm:gap-3">
      <a href="/login" class="hidden sm:inline-flex px-4 py-2 text-sm font-medium text-ink-200 hover:text-white transition">
        Iniciar sesión
      </a>
      
      <button
        id="mobileMenuBtn"
        class="md:hidden w-9 h-9 inline-flex items-center justify-center rounded-lg text-ink-300 hover:text-white hover:bg-white/10 transition"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="mobileMenu"
      >
        <Icon name="burger" class="w-5 h-5" />
      </button>
    </div>
  </nav>

  <!-- Mobile menu -->
  <div id="mobileMenu" class="md:hidden relative z-20 px-6 pb-4 hidden">
    <div class="bg-ink-900 border border-white/10 rounded-2xl p-4 shadow-2xl space-y-1">
      {nav.map((item) => (
        <a href={item.href} class="block px-4 py-3 rounded-xl text-sm font-medium text-ink-200 hover:text-white hover:bg-white/5 transition">
          {item.label}
        </a>
      ))}
      <div class="border-t border-white/10 pt-2 mt-2">
        <a href="/login" class="block px-4 py-3 rounded-xl text-sm font-medium text-brand-400 hover:bg-white/5 transition">
          Iniciar sesión
        </a>
      </div>
    </div>
  </div>

  <!-- ── Hero ────────────────────────────────────────── -->
  <section class="relative z-10 max-w-7xl mx-auto px-6 lg:px-20 pt-12 lg:pt-20 pb-20">
    <div class="grid lg:grid-cols-2 gap-14 lg:gap-20 items-center">
      <div>
        <span class="inline-flex items-center gap-2 px-4 py-2 bg-brand-500/10 border border-brand-500/20 rounded-full text-brand-400 text-xs font-semibold mb-6 animate-fade-in">
          <span class="w-2 h-2 bg-brand-500 rounded-full animate-pulse"></span>
          Nuevas funciones disponibles
        </span>

        <h1 class="font-display text-4xl sm:text-5xl xl:text-6xl font-black leading-[1.08] tracking-tight animate-slide-up">
          Tu carta digital en <span class="text-transparent bg-clip-text bg-gradient-to-r from-brand-400 to-brand-600">minutos</span>
        </h1>

        <p class="text-lg text-ink-300 mt-6 leading-relaxed max-w-xl animate-slide-up [animation-delay:80ms]">
          Crea y administra la carta de tu restaurante de forma fácil. Actualiza precios,
          platos y categorías en tiempo real desde cualquier dispositivo.
        </p>

        <div class="flex flex-col sm:flex-row gap-4 mt-9 animate-slide-up [animation-delay:160ms]">
          <Button href="/login" size="lg">
            Crear mi carta gratis
            <Icon name="arrow-right" class="w-5 h-5" />
          </Button>
          <Button href="#features" variant="outline" size="lg">
            <Icon name="play" class="w-5 h-5" />
            Ver cómo funciona
          </Button>
        </div>

        <div class="flex items-center gap-6 mt-10 animate-fade-in [animation-delay:300ms]">
          <div class="flex -space-x-3">
            {['R', 'M', 'P', 'A'].map((initial, i) => (
              <span
                class={`w-10 h-10 rounded-full bg-gradient-to-br ${['from-brand-400 to-brand-600', 'from-accent-400 to-accent-600', 'from-navy-400 to-navy-600', 'from-teal-400 to-teal-600'][i]} flex items-center justify-center text-white font-bold text-sm border-2 border-ink-950`}
              >
                {initial}
              </span>
            ))}
          </div>
          <div>
            <span class="flex items-center gap-1 text-brand-400">
              {Array.from({ length: 5 }).map(() => <Icon name="star" class="w-4 h-4 fill-current" />)}
            </span>
            <p class="text-sm text-ink-400 mt-1">+500 restaurantes confían en nosotros</p>
          </div>
        </div>
      </div>

      <!-- Phone mockup -->
      <div class="relative flex justify-center lg:justify-end animate-slide-up [animation-delay:200ms]">
        <div class="relative w-[280px] lg:w-[320px] animate-float">
          <div class="relative bg-ink-800 rounded-[2.5rem] p-2 shadow-2xl shadow-black/50">
            <div class="absolute top-4 left-1/2 -translate-x-1/2 w-20 h-5 bg-ink-950 rounded-full z-10"></div>

            <div class="bg-cream text-ink-900 rounded-[2rem] overflow-hidden">
              <div class="bg-gradient-to-br from-ink-800 to-navy-900 text-white p-5 text-center">
                <span class="w-12 h-12 mx-auto mb-2 bg-brand-500/20 rounded-xl flex items-center justify-center text-2xl">
                  {restaurant.logo || '🍽️'}
                </span>
                <h3 class="font-display font-bold text-base">{restaurant.name || 'Carta digital'}</h3>
                {restaurant.slogan && <p class="text-xs text-ink-300 mt-1">{restaurant.slogan}</p>}
              </div>

              <div class="p-4 space-y-4">
                {heroDishes.length > 0 ? (
                  heroDishes.map((dish) => (
                    <div class="flex justify-between items-center gap-3 py-2 border-b border-ink-100 last:border-0">
                      <div class="min-w-0">
                        <p class="font-semibold text-sm truncate">{dish.nombre}</p>
                        <p class="text-xs text-ink-400 line-clamp-1">{dish.descripcion}</p>
                      </div>
                      <span class="font-bold text-sm text-brand-600 shrink-0">S/{dish.precio}</span>
                    </div>
                  ))
                ) : (
                  <p class="text-center text-xs text-ink-400 py-4">Agrega tus primeros platos desde tu panel.</p>
                )}
                <a href="/menu" class="block text-center text-xs font-semibold text-brand-500 hover:text-brand-600 transition">
                  Ver carta completa →
                </a>
              </div>
            </div>
          </div>

          <!-- Floating badges -->
          <div class="hidden sm:flex absolute -left-14 top-24 items-center gap-2 bg-white text-ink-800 rounded-xl p-3 shadow-xl">
            <Icon name="check" class="w-5 h-5 text-mint-500" />
            <span class="text-sm font-semibold">Actualizado</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Features ────────────────────────────────────── -->
  <section id="features" class="relative z-10 max-w-7xl mx-auto px-6 lg:px-20 py-20">
    <div class="text-center mb-14">
      <p class="text-sm font-semibold text-brand-400 uppercase tracking-wider mb-3">Características</p>
      <h2 class="font-display text-3xl lg:text-4xl font-black tracking-tight">
        Todo lo que necesitas para tu carta
      </h2>
      <p class="text-ink-400 mt-4 max-w-2xl mx-auto">
        Herramientas simples pero poderosas para administrar tu menú.
      </p>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      {features.map((feature, i) => (
        <article class="group bg-white/[0.03] border border-white/10 rounded-2xl p-6 hover:bg-white/[0.06] hover:border-brand-500/30 transition-all duration-300">
          <span class="w-12 h-12 bg-brand-500/15 text-brand-400 rounded-xl flex items-center justify-center mb-4 group-hover:scale-110 group-hover:bg-brand-500/25 transition">
            <Icon name={feature.icon} class="w-6 h-6" />
          </span>
          <h3 class="text-lg font-bold text-white mb-2">{feature.title}</h3>
          <p class="text-sm text-ink-400 leading-relaxed">{feature.text}</p>
          <span class="sr-only">{`Feature ${i + 1}`}</span>
        </article>
      ))}
    </div>
  </section>

  <!-- ── How it works ────────────────────────────────── -->
  <section id="how" class="relative z-10 max-w-7xl mx-auto px-6 lg:px-20 py-20">
    <div class="text-center mb-14">
      <p class="text-sm font-semibold text-brand-400 uppercase tracking-wider mb-3">Cómo funciona</p>
      <h2 class="font-display text-3xl lg:text-4xl font-black tracking-tight">Tu carta en 2 pasos</h2>
    </div>

    <div class="grid md:grid-cols-3 gap-6">
      {steps.map((step, i) => (
        <article class="relative bg-white/[0.03] border border-white/10 rounded-2xl p-6">
          <span class="font-display text-5xl font-black text-brand-500/30 absolute top-4 right-6" aria-hidden="true">
            {i + 1}
          </span>
          <h3 class="font-bold text-lg text-white mb-2 pt-6">{step.title}</h3>
          <p class="text-sm text-ink-400 leading-relaxed">{step.text}</p>
        </article>
      ))}
    </div>
  </section>

  <!-- ── Pricing ─────────────────────────────────────── -->
  <section id="pricing" class="relative z-10 max-w-7xl mx-auto px-6 lg:px-20 py-20">
    <div class="text-center mb-14">
      <p class="text-sm font-semibold text-brand-400 uppercase tracking-wider mb-3">Precios</p>
      <h2 class="font-display text-3xl lg:text-4xl font-black tracking-tight">Planes para cada restaurante</h2>
      <p class="text-ink-400 mt-4 max-w-2xl mx-auto">Empieza gratis y crece a tu ritmo.</p>
    </div>

    <div class="grid md:grid-cols-3 gap-6 items-stretch">
      {plans.map((plan) => (
        <article
          class={`relative flex flex-col rounded-2xl p-7 ${
            plan.highlight
              ? 'bg-gradient-to-b from-brand-500/15 to-brand-500/5 border-2 border-brand-500/40 shadow-2xl shadow-brand-500/10'
              : 'bg-white/[0.03] border border-white/10'
          }`}
        >
          {plan.highlight && (
            <span class="absolute -top-3 left-1/2 -translate-x-1/2 px-3 py-1 bg-brand-500 text-white text-[10px] font-bold uppercase tracking-wider rounded-full">
              Más popular
            </span>
          )}

          <h3 class="font-bold text-lg text-white">{plan.name}</h3>
          <p class="mt-3 flex items-baseline gap-1.5">
            <span class="font-display text-4xl font-black text-white">S/{plan.price}</span>
            <span class="text-sm text-ink-400">{plan.period}</span>
          </p>

          <ul class="mt-6 space-y-3 flex-1">
            {plan.features.map((item) => (
              <li class="flex items-start gap-2.5 text-sm text-ink-200">
                <Icon name="check" class="w-4 h-4 text-brand-400 mt-0.5 shrink-0" />
                {item}
              </li>
            ))}
          </ul>

          <Button
            href="/login"
            variant={plan.highlight ? 'primary' : 'outline'}
            class="mt-8 w-full"
          >
            {plan.cta}
          </Button>
        </article>
      ))}
    </div>
  </section>

  <!-- ── CTA ─────────────────────────────────────────── -->
  
</Layout>

<script>
  const menuBtn = document.getElementById('mobileMenuBtn');
  const menu = document.getElementById('mobileMenu');

  menuBtn?.addEventListener('click', () => {
    const isHidden = menu?.classList.contains('hidden');
    menu?.classList.toggle('hidden');
    menuBtn.setAttribute('aria-expanded', String(!isHidden));
  });

  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      menu?.classList.add('hidden');
      menuBtn?.setAttribute('aria-expanded', 'false');
    });
  });
</script>

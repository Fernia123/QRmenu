# Copia este archivo a ".env" y completa con los datos de tu proyecto Supabase.
# Los valores están en: Supabase Dashboard -> Project Settings -> API

# URL del proyecto (expuesta al navegador)
PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave anon public (expuesta al navegador)
PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# Clave service_role (SOLO servidor, nunca la expongas con PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key
